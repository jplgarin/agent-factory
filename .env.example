# Local development only. `make env` copies this to .env and fills in random passwords; on an
# existing .env it only adds missing keys.
# Never commit .env. In production, values come from the secret manager (ADR 0005).
# Passwords are embedded in connection URLs: use only letters, digits, '-' and '_'.
# Bootstrap superuser. Only postgres, db-roles and Temporal receive it (ADR 0002).
POSTGRES_USER=af_dev
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Agent Factory roles: af_owner runs migrations, each space role serves one space.
AF_OWNER_DB_PASSWORD=
AF_PERSONAL_DB_PASSWORD=
AF_SYNAPTION_DB_PASSWORD=

# Host directory mounted read-only as AF_CONFIG_DIR. Point it at your private config repo.
AF_CONFIG_DIR_HOST=./config.example

# Optional host port overrides (always bound to 127.0.0.1).
# AF_GATEWAY_PORT=8000
# AF_TEMPORAL_PORT=7233
# AF_TEMPORAL_UI_PORT=8080
# AF_POSTGRES_PORT=5432
# AF_REDIS_PORT=6379
